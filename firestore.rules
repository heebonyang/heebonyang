rules_version = '2';

// 누구나 음원·팀·공지·방명록을 읽을 수 있고, 방명록 글은 누구나 남길 수 있음.
// 음원·팀·공지 수정과 방명록 글 삭제는 관리자 구글 계정만 가능.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "gmlqhs@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /releases/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teams/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 각 탭 머리글 같은 사이트 문구
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notices/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 방명록: 누구나 이름·비밀번호를 정해 글을 남기고, 같은 비밀번호로 자기 글을 지울 수 있음.
    // 비밀번호는 브라우저에서 해시로 바꾼 값만 guestbookKeys에 저장하고, 이 컬렉션은 아무도 읽을 수 없음.
    match /guestbook/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(["name", "message", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/guestbookKeys/$(id));
      // 작성자 삭제: 같은 묶음 요청으로 guestbookUnlock에 남긴 해시가 저장된 해시와 같아야 함
      allow delete: if isAdmin()
        || getAfter(/databases/$(database)/documents/guestbookUnlock/$(id)).data.hash
          == get(/databases/$(database)/documents/guestbookKeys/$(id)).data.hash;
    }

    // 글을 쓸 때 같은 묶음 요청으로 한 번만 만들 수 있음
    match /guestbookKeys/{id} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(["hash"])
        && request.resource.data.hash is string
        && request.resource.data.hash.size() == 64
        && !exists(/databases/$(database)/documents/guestbook/$(id))
        && existsAfter(/databases/$(database)/documents/guestbook/$(id));
    }

    // 글을 지울 때 같은 묶음 요청으로만 만들 수 있음 (확인용, 아무도 읽을 수 없음)
    match /guestbookUnlock/{id} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(["hash"])
        && request.resource.data.hash is string
        && exists(/databases/$(database)/documents/guestbook/$(id))
        && !existsAfter(/databases/$(database)/documents/guestbook/$(id));
    }
  }
}
