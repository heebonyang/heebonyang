rules_version = '2';

// 누구나 음원·팀·공지·방명록을 읽을 수 있고, 방명록 글은 누구나 남길 수 있음.
// 음원·팀·공지 수정과 방명록 글 삭제는 관리자 구글 계정만 가능.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "gmlqhs@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /releases/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teams/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 각 탭 머리글 같은 사이트 문구
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notices/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 미발매곡(데모) 목록
    match /demos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 관리자 페이지에서 올린 음원 파일 (900KB 조각으로 나눠 저장, app/audioStore.ts)
    match /audioFiles/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /chunks/{part} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // 0집 CD 주문 (계좌이체). 누구나 주문서를 낼 수 있지만, 주문 목록을 보거나 바꾸는 건 관리자만.
    // 주문서는 0집 페이지(heebonmd.web.app)에서 Firestore REST로 저장됨. 입금 확인 시 관리자 페이지에서 남은 수량을 줄임.
    match /orders/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(["name", "phone", "address", "qty", "depositor", "memo", "source", "status", "createdAt", "agree"])
        && request.resource.data.keys().hasAll(["name", "phone", "address", "qty", "depositor", "memo", "source", "status", "createdAt", "agree"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.phone is string
        && request.resource.data.phone.matches("^[0-9][0-9-]{8,13}$")
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 5
        && request.resource.data.address.size() <= 200
        && request.resource.data.qty is int
        && request.resource.data.qty >= 1
        && request.resource.data.qty <= 10
        && request.resource.data.qty <= get(/databases/$(database)/documents/settings/site).data.albumStock
        && request.resource.data.depositor is string
        && request.resource.data.depositor.size() > 0
        && request.resource.data.depositor.size() <= 30
        && request.resource.data.memo is string
        && request.resource.data.memo.size() <= 300
        && request.resource.data.source in ["md", "shop"]
        && request.resource.data.status == "new"
        && request.resource.data.createdAt == request.time
        && request.resource.data.agree == true;
    }

    // 방명록: 누구나 이름·비밀번호를 정해 글을 남기고, 같은 비밀번호로 자기 글을 지울 수 있음.
    // 비밀번호는 브라우저에서 해시로 바꾼 값만 guestbookKeys에 저장하고, 이 컬렉션은 아무도 읽을 수 없음.
    match /guestbook/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(["name", "message", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/guestbookKeys/$(id));
      // 하트: 홈페이지 주인(관리자)만, liked 칸만 바꿀 수 있음
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["liked"])
        && request.resource.data.liked is bool;
      // 작성자 삭제: 같은 묶음 요청으로 guestbookUnlock에 남긴 해시가 저장된 해시와 같아야 함
      allow delete: if isAdmin()
        || getAfter(/databases/$(database)/documents/guestbookUnlock/$(id)).data.hash
          == get(/databases/$(database)/documents/guestbookKeys/$(id)).data.hash;
    }

    // 글을 쓸 때 같은 묶음 요청으로 한 번만 만들 수 있음
    match /guestbookKeys/{id} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(["hash"])
        && request.resource.data.hash is string
        && request.resource.data.hash.size() == 64
        && !exists(/databases/$(database)/documents/guestbook/$(id))
        && existsAfter(/databases/$(database)/documents/guestbook/$(id));
    }

    // 글을 지울 때 같은 묶음 요청으로만 만들 수 있음 (확인용, 아무도 읽을 수 없음)
    match /guestbookUnlock/{id} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(["hash"])
        && request.resource.data.hash is string
        && exists(/databases/$(database)/documents/guestbook/$(id))
        && !existsAfter(/databases/$(database)/documents/guestbook/$(id));
    }
  }
}
